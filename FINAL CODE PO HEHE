def main():

    while True:
        display_main_menu()

        choice = input("Enter your choice: ").upper()

        if choice == "1":
            title = "PRELIM"
            lessons = prelim_lessons

        elif choice == "2":
            title = "MIDTERM"
            lessons = midterm_lessons

        elif choice == "3":
            title = "FINAL"
            lessons = final_lessons

        elif choice == "4":
            print("\n=================================")
            print("THANK YOU FOR USING MY PROGRAM!")
            print("KEEP LEARNING PYTHON!")
            print("=================================")
            break

        else:
            print("\nInvalid choice. Please try again.")
            continue

        while True:
            display_lesson_menu(title, lessons)

            lesson_choice = input("Enter your choice: ").upper()

            if lesson_choice == "0":
                break

            elif lesson_choice == "E":
                take_quiz(title, lessons)

            elif lesson_choice.isdigit():
                number = int(lesson_choice)

                if number in lessons:
                    show_lesson(title, lessons[number])
                else:
                    print("Invalid lesson number.")

            else:
                print("Invalid choice. Please try again.")


# ==========================================
#          RUN THE PROGRAM
# ==========================================

main()
